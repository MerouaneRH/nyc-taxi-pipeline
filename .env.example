# Copy to .env and edit. Never commit .env.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=nyc-taxi-airflow:2.10.5
AIRFLOW__CORE__FERNET_KEY=
# Local-only admin login for the Airflow UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow
# AWS: credentials come from ~/.aws mounted read-only; no keys here.
AWS_PROFILE=default
AWS_REGION=eu-west-3
S3_BUCKET=merouane-nyc-taxi-raw-euw3-2026
