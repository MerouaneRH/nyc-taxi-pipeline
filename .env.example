# Copy to .env and replace every <...> placeholder. Never commit .env.
# Used by docker-compose.yml. AWS credentials are NOT set here: put the
# nyc-taxi profile in ./.aws-airflow/{config,credentials} (gitignored).

# Postgres (Airflow metadata DB)
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=<choose-a-password>

# Airflow web login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<choose-a-password>

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=<generated-fernet-key>
# Generate: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=<generated-secret>

# On Linux set this to your uid (id -u); 50000 is fine on macOS
AIRFLOW_UID=50000

# AWS (non-secret settings)
AWS_REGION=eu-west-3
S3_BUCKET=<your-bucket-name>
